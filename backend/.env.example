# Service wallet — creates all Arkiv entities on Tiramisu and pushes prices on Polygon Amoy.
# Never commit the real .env file (gitignored via **/.env).
PRIVATE_KEY=0xabc...

# Polygon Amoy (chain 80002)
AMOY_RPC_URL=https://polygon-amoy-bor-rpc.publicnode.com
# Optional: address of EqoraPriceOracle. Auto-loaded from
# contracts/deployments/polygonAmoy.json when omitted.
AMOY_ORACLE_ADDRESS=

# Tiramisu (chain 7738577) — optional free access key from https://hub.arkiv.network
TIRAMISU_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
TIRAMISU_ACCESS_KEY=

# HTTP API
PORT=8787
