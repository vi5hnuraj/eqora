#!/usr/bin/env bash
set -euo pipefail

echo "============================================="
echo "   EQORA Full Project Verification           "
echo "============================================="

# 1. Compile smart contracts
echo "[1/3] Compiling smart contracts..."
(cd contracts && npx hardhat compile)
echo "  [OK] Smart contracts compiled successfully."

# 2. Run smart contract unit tests
echo "[2/3] Running smart contract test suite..."
(cd contracts && npx hardhat test)
echo "  [OK] All smart contract tests passed."

# 3. Build frontend
echo "[3/3] Building frontend production bundle..."
(cd frontend && npm run build)
echo "  [OK] Frontend build succeeded."

echo "============================================="
echo "   Verification Complete: ALL SYSTEMS PASS   "
echo "============================================="
